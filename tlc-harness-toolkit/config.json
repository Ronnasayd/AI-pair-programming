{
  "$schema": "https://unpkg.com/@tech-leads-club/harness-toolkit@0.16/schema.json",
  "version": 1,
  "codePaths": [
    "src",
    "app",
    "apps",
    "lib",
    "libs",
    "packages",
    "pkg",
    "cmd",
    "internal",
    "server",
    "client",
    "backend",
    "frontend",
    "api",
    "services",
    "components",
    "pages",
    "hooks",
    "scripts",
    "tools",
    "utils",
    "tests",
    "test",
    "__tests__",
    "e2e"
  ],
  "mode": "solo",
  "grind": {
    "enabled": true,
    "lintCommand": ["uv", "run", ".claude/hooks/scripts/lint_changed.py"],
    "maxLoops": 5
  },
  "comments": {
    "enabled": true,
    "mode": "declared"
  }
}
