{
  "$schema": "https://unpkg.com/@tech-leads-club/harness-toolkit@0.16/schema.json",
  "version": 1,
  "codePaths": ["$CLAUDE_PROJECT_DIR$"],
  "mode": "solo",
  "grind": {
    "enabled": true,
    "lintCommand": ["uv", "run", ".claude/hooks/scripts/lint_changed.py"],
    "maxLoops": 5
  },
  "comments": {
    "enabled": true,
    "mode": "declared"
  }
}
