{
  "hook": "scripts/structural_clone_ref.py",
  "mode": "stdout",
  "description": "Eval cases for structural_clone_ref.py (PostToolUse Edit|Write rag-rat clones_for_symbol hook)",
  "cases": [
    {
      "name": "non_edit_write_tool_no_output",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "ls"
        }
      },
      "expect_output": false
    },
    {
      "name": "no_file_path_no_output",
      "input": {
        "tool_name": "Write",
        "tool_input": {}
      },
      "expect_output": false
    },
    {
      "name": "non_source_ext_no_output",
      "input": {
        "tool_name": "Write",
        "tool_input": {
          "file_path": "README.md"
        }
      },
      "expect_output": false
    },
    {
      "name": "malformed_json_no_output",
      "raw_stdin": "{not valid json",
      "expect_output": false
    },
    {
      "name": "empty_stdin_no_output",
      "raw_stdin": "",
      "expect_output": false
    },
    {
      "name": "nonexistent_file_no_output",
      "input": {
        "tool_name": "Write",
        "tool_input": {
          "file_path": "hooks/scripts/does_not_exist_xyz.py"
        }
      },
      "expect_output": false
    },
    {
      "name": "known_clone_class_member_reports_duplicate",
      "input": {
        "tool_name": "Write",
        "tool_input": {
          "file_path": "src/backups/split_by_tokens.py"
        }
      },
      "expect_output": true,
      "expect_pattern": "is a structural clone of"
    }
  ]
}
