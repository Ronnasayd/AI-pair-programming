{
  "hook": "scripts/impact_surface_hint.py",
  "mode": "stdout",
  "description": "Eval cases for impact_surface_hint.py (PostToolUse Edit|MultiEdit rag-rat impact hint)",
  "cases": [
    {
      "name": "non_edit_tool_no_output",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "ls"
        }
      },
      "expect_output": false
    },
    {
      "name": "no_file_path_no_output",
      "input": {
        "tool_name": "Edit",
        "tool_input": {
          "old_string": "a",
          "new_string": "b"
        }
      },
      "expect_output": false
    },
    {
      "name": "non_source_suffix_no_output",
      "input": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "README.md",
          "old_string": "a",
          "new_string": "b"
        }
      },
      "expect_output": false
    },
    {
      "name": "malformed_json_no_output",
      "raw_stdin": "{not valid json",
      "expect_output": false
    },
    {
      "name": "empty_stdin_no_output",
      "raw_stdin": "",
      "expect_output": false
    },
    {
      "name": "edit_split_on_operators_has_callers_or_callees",
      "input": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "hooks/scripts/utils.py",
          "old_string": "def split_on_operators(command: str, protect_exec: bool = False) -> list[str]:",
          "new_string": "def split_on_operators(command: str, protect_exec: bool = False) -> list[str]:\n    # eval probe comment"
        }
      },
      "expect_output": true,
      "expect_pattern": "split_on_operators"
    }
  ]
}
